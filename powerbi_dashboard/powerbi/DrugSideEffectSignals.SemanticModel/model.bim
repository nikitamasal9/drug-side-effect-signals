{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "_Measures",
        "lineageTag": "16468e8d-c025-52ab-aab6-c9efb39dac5a",
        "columns": [
          {
            "name": "Dummy",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Dummy",
            "summarizeBy": "none",
            "lineageTag": "090cb8e7-7f8d-551d-9972-d7cd12935222"
          }
        ],
        "measures": [
          {
            "name": "Drugs analysed",
            "expression": "COUNTROWS ( dim_drug )",
            "lineageTag": "8d287a6c-d261-55b2-8b77-6035f3ba4b42",
            "formatString": "#,0"
          },
          {
            "name": "Distinct side effects",
            "expression": "COUNTROWS ( dim_side_effect )",
            "lineageTag": "dcb7bad9-0e75-58a7-895f-a830b81903cb",
            "formatString": "#,0"
          },
          {
            "name": "Drug side-effect pairs",
            "expression": "COUNTROWS ( fact_drug_side_effect )",
            "lineageTag": "2e227c7c-9b56-5bc4-a649-4e3eb1b7a7fc",
            "formatString": "#,0"
          },
          {
            "name": "Pairs tested",
            "expression": "COUNTROWS ( an_class_signals )",
            "lineageTag": "1f0f2b7e-c66d-5e04-af1a-68e9fb37f1f2",
            "formatString": "#,0"
          },
          {
            "name": "Class signals",
            "expression": "CALCULATE ( COUNTROWS ( an_class_signals ), an_class_signals[is_signal] = TRUE () )",
            "lineageTag": "20750db4-ed89-5292-9034-75835c4ecf20",
            "formatString": "#,0"
          },
          {
            "name": "Known effects recovered",
            "expression": "VAR recovered = CALCULATE ( COUNTROWS ( an_known_effect_check ), an_known_effect_check[status] = \"recovered\" )\nVAR testable = CALCULATE ( COUNTROWS ( an_known_effect_check ), an_known_effect_check[status] <> \"not tested (too few drugs)\" )\nRETURN recovered & \" of \" & testable",
            "lineageTag": "291c534f-cc66-595d-84e8-87aaca905942"
          },
          {
            "name": "Compounds",
            "expression": "SUM ( an_q01_data_funnel[n] )",
            "lineageTag": "9340ef5e-baf6-5231-83b9-ac2942e08264",
            "formatString": "#,0"
          },
          {
            "name": "In class",
            "expression": "SUM ( an_known_effect_check[pct_in_class] )",
            "lineageTag": "bee6b7f1-5d29-5ff5-875e-73b9a2e4cfee",
            "formatString": "0%"
          },
          {
            "name": "All other drugs",
            "expression": "SUM ( an_known_effect_check[pct_outside_class] )",
            "lineageTag": "7e420799-20b4-55eb-8f6e-617bbbacdef2",
            "formatString": "0%"
          },
          {
            "name": "Median side effects per drug",
            "expression": "SUM ( an_q03_burden_by_class[median_side_effects] )",
            "lineageTag": "562f4e6c-f665-58d6-ba37-4f3a3e978a43",
            "formatString": "#,0"
          },
          {
            "name": "Median serious side effects",
            "expression": "SUM ( an_q03_burden_by_class[median_serious] )",
            "lineageTag": "d5a56bea-7038-55fd-8ea1-502072a147f6",
            "formatString": "#,0.0"
          },
          {
            "name": "Share with any serious effect",
            "expression": "SUM ( an_q03_burden_by_class[pct_with_any_serious] )",
            "lineageTag": "1a89ef94-cd35-5cbb-85d3-6892586975a5",
            "formatString": "0%"
          },
          {
            "name": "Drugs in class",
            "expression": "MAX ( an_class_signals[drugs_in_class] )",
            "lineageTag": "aa772cf3-0e3a-5f41-976c-ac21cc73ebc8",
            "formatString": "#,0"
          },
          {
            "name": "Share in class",
            "expression": "CALCULATE ( MAX ( an_class_signals[pct_in_class] ), KEEPFILTERS ( an_class_signals[is_signal] = TRUE () ) )",
            "lineageTag": "f4fff55c-426b-58d0-a42b-7e3a438f3da0",
            "formatString": "0%"
          },
          {
            "name": "Share of other drugs",
            "expression": "CALCULATE ( MAX ( an_class_signals[pct_outside_class] ), KEEPFILTERS ( an_class_signals[is_signal] = TRUE () ) )",
            "lineageTag": "1cf01925-eea6-5adc-aec1-d437dc2fc3e6",
            "formatString": "0.0%"
          },
          {
            "name": "Odds ratio",
            "expression": "CALCULATE ( MAX ( an_class_signals[odds_ratio] ), KEEPFILTERS ( an_class_signals[is_signal] = TRUE () ) )",
            "lineageTag": "7981f393-f1e9-5c02-971a-6c50536c67c8",
            "formatString": "#,0.0"
          },
          {
            "name": "q value",
            "expression": "CALCULATE ( MIN ( an_class_signals[q_value] ), KEEPFILTERS ( an_class_signals[is_signal] = TRUE () ) )",
            "lineageTag": "45b8a4c8-1e34-5b51-befa-b0ff4f333a17",
            "formatString": "0.0E+00"
          },
          {
            "name": "Drugs with side effect",
            "expression": "CALCULATE ( MAX ( an_class_signals[drugs_in_class_with_se] ), KEEPFILTERS ( an_class_signals[is_signal] = TRUE () ) )",
            "lineageTag": "88a81af1-6372-5668-a76d-c06423947541",
            "formatString": "#,0"
          },
          {
            "name": "Labelled side effects",
            "expression": "COALESCE ( COUNTROWS ( fact_drug_side_effect ), 0 )",
            "lineageTag": "5633248b-0eac-52a9-a807-400a9cc14c5c",
            "formatString": "#,0"
          },
          {
            "name": "Serious side effects",
            "expression": "COALESCE ( CALCULATE ( COUNTROWS ( fact_drug_side_effect ), KEEPFILTERS ( dim_side_effect[is_serious] = TRUE () ) ), 0 )",
            "lineageTag": "8be9c6dd-0339-5b4a-8d52-74e3cdd346d1",
            "formatString": "#,0"
          },
          {
            "name": "Labelled indications",
            "expression": "COALESCE ( COUNTROWS ( fact_drug_indication ), 0 )",
            "lineageTag": "abe3cd3b-924b-5882-94b0-9e1581730011",
            "formatString": "#,0"
          },
          {
            "name": "Drug classes",
            "expression": "IF ( HASONEVALUE ( dim_drug[drugbank_id] ),\n    VAR codes = SELECTEDVALUE ( dim_drug[atc_l4_codes] )\n    RETURN IF ( ISBLANK ( codes ) || codes = \"\", \"No WHO class\", SUBSTITUTE ( codes, \"|\", \", \" ) ),\n    \"Select one drug\" )",
            "lineageTag": "60787209-a8f5-5555-bf78-411c3e5ba927"
          },
          {
            "name": "Drug arm rate",
            "expression": "AVERAGE ( fact_drug_side_effect[freq_drug] )",
            "lineageTag": "bbf8e36c-a3e6-5a49-98bb-d29542bf4865",
            "formatString": "0.0%"
          },
          {
            "name": "Placebo arm rate",
            "expression": "AVERAGE ( fact_drug_side_effect[freq_placebo] )",
            "lineageTag": "08dc27a8-ef90-587c-849b-6b3eb4fdb383",
            "formatString": "0.0%"
          },
          {
            "name": "Serious on label",
            "expression": "VAR listed = CALCULATE ( COUNTROWS ( fact_drug_side_effect ), KEEPFILTERS ( dim_side_effect[is_serious] = TRUE () ) )\nVAR pmOnly = CALCULATE ( COUNTROWS ( fact_drug_side_effect ), KEEPFILTERS ( dim_side_effect[is_serious] = TRUE () ),\n    KEEPFILTERS ( fact_drug_side_effect[postmarketing_only] = TRUE () ) )\nRETURN IF ( listed > 0, IF ( pmOnly = listed, \"Post-marketing only\", \"Label / trials\" ) )",
            "lineageTag": "fd247c09-3cf5-5da5-966a-051efcfe9d3e"
          },
          {
            "name": "Serious trial rate",
            "expression": "IF ( NOT ISBLANK ( [Serious on label] ), [Drug arm rate] )",
            "lineageTag": "7909cdb8-f617-5165-93fe-aa21f7d60ec4",
            "formatString": "0.0%"
          },
          {
            "name": "Share post-marketing only",
            "expression": "SUM ( an_q07_postmarketing_serious[share_postmarketing_only] )",
            "lineageTag": "941388db-d800-577d-91dd-c0a00fd13948",
            "formatString": "0%"
          },
          {
            "name": "Share of drugs",
            "expression": "SUM ( an_q04_class_heatmap[pct_of_drugs] )",
            "lineageTag": "ce8067e4-10d8-5d55-81b6-a629e193832e",
            "formatString": "0%"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = #table(type table [Dummy = text], {})\nin\n    Source"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
